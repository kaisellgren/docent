# Local database (Podman)
DATABASE_URL=postgres://docent:docent@localhost:5432/docent

# Application
APP_URL=http://localhost:5173
# The public Cloud Run URL, used only by CDKTF after the first web deployment.
DOCENT_APP_URL=
# Bump after rotating a Google OAuth secret to roll new Cloud Run instances.
DOCENT_OAUTH_SECRET_ROLLOUT=1
SESSION_SECRET=replace-with-at-least-32-random-characters
EDITOR_EMAILS=kaisellgren@gmail.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-north1
VERTEX_CHAT_MODEL=gemini-2.0-flash-lite
VERTEX_EMBEDDING_MODEL=gemini-embedding-001
GCS_BUCKET=
CLOUD_TASKS_QUEUE=
CLOUD_TASKS_LOCATION=europe-west1
CLOUD_RUN_TASK_URL=
CLOUD_TASKS_SERVICE_ACCOUNT_EMAIL=
CLOUD_RUN_TASK_AUDIENCE=
